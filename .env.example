# Copiá este archivo como .env.local y completá los valores.
# .env.local está en .gitignore: nunca se commitea.
#
# Los tres valores salen de Supabase → Settings → API.

# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública ("anon"). NEXT_PUBLIC_ significa que viaja al navegador.
# Es pública por diseño: lo que la regula es RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Clave de servicio. SALTEA RLS: puede leer y escribir cualquier tabla.
# Solo se usa en el servidor (app/api/*). Nunca la pongas en una variable
# NEXT_PUBLIC_, ni en el código, ni la pegues en un chat.
# Sin ella la app levanta igual, pero fallan la carga de CSV y el
# recálculo de Growth.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...
